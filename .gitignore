venv/
.venv/
.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/
notebooks/*_executed.ipynb
notebooks/*_partial.ipynb

# Analysis output regenerated by the notebook
outputs/

# Power BI local working files
powerbi/_extract/
~$*
# Power BI Project (.pbip) local artifacts.
# The .tmdl / .json definition files ARE the source and must stay tracked; these
# are per-user cache and window state that change on every open.
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/

# Misc
*.sqlite
*.db
.env
